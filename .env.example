# TradingBot — environment variables (KEY-ONLY template).
# Copy to `.env` and fill in values. Never commit real secrets.

# Canonical public base URL. Leave empty to use the default (https://trading-bot-dxt.pages.dev).
NUXT_PUBLIC_BASE_URL=

# Affiliate / tracking links. Paste the full tracking URL when the affiliate
# account exists. Empty = the official, non-tracking URL is used as fallback.
NUXT_PUBLIC_AFFILIATE_SCRAMBLY=
NUXT_PUBLIC_AFFILIATE_WEBULL=
NUXT_PUBLIC_AFFILIATE_MERCOR=
NUXT_PUBLIC_AFFILIATE_UPWORK_FIVERR=
NUXT_PUBLIC_AFFILIATE_AMAZON_ASSOCIATES=
NUXT_PUBLIC_AFFILIATE_DEPOP=

# Supabase Auth (real auth). Create a Supabase project, then paste:
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated emails allowed to access /admin.
NUXT_PUBLIC_ADMIN_EMAILS=
