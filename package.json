{
  "name": "money-conversion-spa",
  "version": "1.0.0",
  "private": true,
  "description": "A Nuxt 4 statically-generated PWA for curated money-making resource links with Material Design 3 and viral conversion design",
  "theme": {
    "primary": "#6750A4",
    "secondary": "#958DA5",
    "tertiary": "#7D5260"
  },
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "maintained node versions"
  ],
  "scripts": {
    "dev": "nuxi dev",
    "generate": "nuxi generate",
    "pregenerate": "node scripts/audit-check.mjs",
    "build": "nuxi build",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "lint": "eslint .",
    "lint:tiers": "node scripts/check-atomic-tiers.mjs",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run && playwright test"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.3.0",
    "@nuxtjs/i18n": "10.4.0",
    "@nuxtjs/seo": "3.4.0",
    "@pinia/nuxt": "0.11.3",
    "@vite-pwa/nuxt": "1.1.1",
    "nuxt": "4.4.7",
    "nuxt-security": "2.6.0",
    "pinia": "3.0.4",
    "vue": "3.5.35"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.15.2",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "1.52.0",
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.8",
    "@vue/devtools-api": "^8.1.2",
    "@vue/test-utils": "2.4.11",
    "eslint": "9.28.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-vuejs-accessibility": "2.4.1",
    "fast-check": "4.8.0",
    "happy-dom": "20.10.1",
    "oxc-parser": "^0.134.0",
    "playwright": "1.52.0",
    "prettier": "3.5.3",
    "tailwindcss": "4.3.0",
    "typescript": "5.8.3",
    "vitest": "4.1.8",
    "vue-tsc": "2.2.10"
  }
}
